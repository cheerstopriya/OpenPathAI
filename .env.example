# Copy to .env for local development. Never commit real secrets.
OPENPATH_ENVIRONMENT=development
OPENPATH_LOG_LEVEL=INFO
OPENPATH_API_TITLE=OpenPath AI API
OPENPATH_API_VERSION=0.1.0

# Optional for public repositories. Keep real tokens only in an untracked .env file.
OPENPATH_GITHUB_TOKEN=
OPENPATH_GITHUB_API_VERSION=2026-03-10
OPENPATH_GITHUB_TIMEOUT_SECONDS=5.0
